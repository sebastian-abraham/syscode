{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SysCode",
  "version": "0.1.0",
  "identifier": "dev.syscode.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -w @syscode/web",
    "beforeBuildCommand": "npm run build -w @syscode/web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A living design map for agent-built software"
  }
}
