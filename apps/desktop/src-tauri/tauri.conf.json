{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SysCode",
  "version": "0.1.0",
  "identifier": "dev.syscode.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -w @syscode/web",
    "beforeBuildCommand": "npm run build -w @syscode/web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "A living design map for agent-built software",
    "resources": {
      "../../../dist/engine/syscode-engine": "engine/syscode-engine",
      "../../../dist/engine/web": "web"
    }
  }
}
